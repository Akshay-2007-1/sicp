gY3IdiFZPGwU7GCDN6d7N-YbaKaJ7FgEdh+s9zQC9jNo9jd+4yBYTedjtqvUd1d+4UwWN+gZdh+lwdAZ+MlBxxd8lxotNyQVACdgANiJBA7NbA7-bX0fZAAABYp2XAmnwOiz0AA2otzX-WUOziD3sggA","body":"const gcd_machine =\n    make_machine(\n        list(\"a\", \"b\", \"t\"),\n        list(list(\"rem\", (a, b) => a % b),\n             list(\"=\", (a, b) => a === b)),\n        list(\n          \"test_b\",\n            test(list(op(\"=\"), reg(\"b\"), constant(0))),\n            branch(label(\"gcd_done\")),\n            assign(\"t\", list(op(\"rem\"), reg(\"a\"), reg(\"b\"))),\n            assign(\"a\", reg(\"b\")),\n            assign(\"b\", reg(\"t\")),\n            go_to(label(\"test_b\")),\n          \"gcd_done\")); "},{"body":"\n    The first argument to\n    ","tag":"#text"},{"tag":"PYTHONINLINE","body":"make_machine"},{"body":"\n    is a list of register names. The next argument is a table (a list of\n    two-element lists) that pairs each operation name with a \n    Python function\n    that implements the operation (that is, produces the same output value\n    given the same input values). The last argument specifies the controller\n    as a list of labels and machine instructions, as in\n    section ","tag":"#text"},{"tag":"REF","body":"5.1","href":"/sicpjs/5.1"},{"body":".\n  ","tag":"#text"}]},{"tag":"TEXT","id":"#p3","child":[{"body":"\n    To compute GCDs with this machine, we set the input registers, start the\n    machine, and examine the result when the simulation terminates:\n    ","tag":"#text"},{"tag":"SNIPPET","latex":false,"id":2,"eval":true,"prependLength":490,"program":"chap=4&-JJ9CIxCyzUzOZoSFgQKkFdyOPw8AwY9GI4TVEiuSNeQQBTnsfn6DH6NccEYY0SHTLDtxlNMAHwgAh7TSuZ5MmhHDNZqnJ+sRov+EtqB01o48tgC8kVKoi7iSpOMmdb5NzwmD5EduVdmZ9tJsU+5EfW8eZ44WDhcA-H1PI5eMAVmJgsJYXB8IICbiq+VgHgBVCfne+znpQl69tQdD0NynD5mwdjZCASLDnSj6LpqLxvHOhp4H8gKUDGzALBEvgBGOkKCjadptkOxL5F49E+n6ILbBQUFRjGcagYYe4ER0XQCX0X79hWGz+OupSbv6dTcPxvRQZ0x5SVsvRSuWPJzJ4a6zAI-jRle3r8L6amBsGoYRvWWDRqJBiJqajL9OIZYOv5mkRNp0lKlhrbsRoCGZt2fb8P4-h