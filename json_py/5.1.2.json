em_loop\",\n      test(list(op(\"<\"), reg(\"t\"), reg(\"b\"))),\n      branch(label(\"rem_done\")),\n      assign(\"t\", list(op(\"-\"), reg(\"t\"), reg(\"b\"))),\n      go_to(label(\"rem_loop\")),\n    \"rem_done\",\n      assign(\"a\", reg(\"b\")),\n      assign(\"b\", reg(\"t\")),\n      go_to(label(\"test_b\")),\n    \"gcd_done\")) "},"captionHref":"/sicpjs/5.1.2#fig-5.6","captionName":"Figure 5.6 ","captionBody":[{"body":"Controller instruction sequence for the GCD machine in\n      figure ","tag":"#text"},{"tag":"REF","body":"5.5","href":"/sicpjs/5.1.2#fig-5.5"},{"body":".","tag":"#text"}]}]},{"tag":"EXERCISE","title":"Exercise 5.3","id":"#ex-5.3","child":[{"body":"\n    Design a machine to compute\n    \n    square roots using Newton's method, as\n    described in section ","tag":"#text"},{"tag":"REF","body":"1.1.7","href":"/sicpjs/1.1.7"},{"body":" and implemented with the following code in section ","tag":"#text"},{"tag":"REF","body":"1.1.8","href":"/sicpjs/1.1.8"},{"body":":\n    ","tag":"#text"},{"tag":"SNIPPET","latex":false,"id":4,"eval":true,"prependLength":6,"program":"chap=4&prgrm=MQAgygkgwgCgniArAOgIzIEwCgsBMCmAZiAM4COArgIYBO+AFAB4CUAXCHQC4U0B2IjEACoBOAsSoA3fDSoBzBowA0IOGywhNHfNz4gmIANSrmIAPQhsWQhV4BjTgEsA9v3I1OTUwG8NWm-ZOriCOJAD6cs7OuGH4vM4UcgAW9HIU+CQkPn5aWlw8-AC2VJxJYVQARiT05NR0qemZpgC0AqYAPCAADMhdXagA3DkgAL7DAQ4u-I6FAA40ztINGVkgvrm5+XpSMvIMaSsqghYHTUO5Y7kTQW5kHmGOnDLLTWvDmzoFIeGR0bHxiRSpyy7w2GwA-CBgaCwVp2O5OA8njR6DN5ot9o0ssxzlpLnlPnpSHdEY9nqgcVgxlh5o5eJ4EfREMxmEA","body":"function sqrt(x) {\n    function is_good_enough(guess) {\n        return math_abs(square(guess) - x) < 0.001;\n    }\n    function improve(guess) {\n        return average(guess, x / guess);\n    }\n    function sqrt_iter(guess) {\n        return is_good_enough(guess)\n               ? guess\n               : sqrt_iter(improve(guess));\n    }\n    return  sqrt_iter(1);\n} "},{"body":"\n    Begin by assuming that\n    ","tag":"#text"},{"tag":"PYTHONINLINE","body":"is_good_enough"},{"body":"\n    and ","tag":"#text"},{"tag":"PYTHONINLINE","body":"improve"},{"body":" operations are available as\n    primitives.  Then show how to expand these in terms of arithmetic\n    operations.  Describe each version of the ","tag":"#text"},{"tag":"PYTHONINLINE","body":"sqrt"},{"body":"\n    machine design by drawing a data-path diagram and writing a controller\n    definition in the register-machine language.\n    ","tag":"#text"}]}]